# Xserver FTP 接続情報（GitHub Actions の Secrets と同じ名前）
# このファイルを .env にコピーして値を埋めてください。.env は Git に含まれません。

# サーバーパネルに表示されるホスト名（例: sv12345.xserver.jp）
XSERVER_FTP_HOST=

# FTPアカウント名（専用アカウントなら xxx@tsunagari-guild.com 形式）
XSERVER_FTP_USER=

# FTPアカウントのパスワード
XSERVER_FTP_PASSWORD=

# アップロード先ディレクトリ
#   専用FTPアカウント（ホームを /tsunagari-guild.com/public_html/snow にした場合）: /
#   メインのサーバーアカウントで接続する場合: /tsunagari-guild.com/public_html/snow/
XSERVER_REMOTE_DIR=/
