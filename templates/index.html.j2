<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.title }}</title>
<style>
  body { font-family: "Zen Kaku Gothic New", "Noto Sans JP", sans-serif; max-width: 480px; margin: 40px auto; padding: 0 20px; color: #1c2a3a; }
  h1 { font-size: 20px; }
  ul { list-style: none; padding: 0; }
  li { margin: 12px 0; }
  a { display: block; padding: 14px 16px; border: 1px solid #d7dfe7; border-radius: 10px; text-decoration: none; color: #1c2a3a; font-weight: 700; }
  a:hover { border-color: #de5b2c; color: #de5b2c; }
</style>
</head>
<body>
  <h1>{{ site.heading }}</h1>
  <ul>
{%- for r in resorts %}
    <li><a href="{{ r.out }}">{{ r.name }}</a></li>
{%- endfor %}
  </ul>
</body>
</html>
