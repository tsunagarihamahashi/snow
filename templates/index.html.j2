<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.title }}</title>
<link rel="stylesheet" href="assets/site.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap">
</head>
<body class="directory-page">
  <main class="directory-wrap">
    <div class="directory-kicker"><svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M3 24 12 9l5 8 3-5 9 12H3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 24h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span>SNOW GUIDE</span></div>
    <h1>{{ site.heading }}</h1>
  <p class="lead">全{{ total }}ゲレンデ（都道府県別）</p>
{%- for g in groups %}
  <h2>{{ g.pref }}<span class="count">{{ g['items'] | length }}件</span></h2>
  <ul>
{%- for r in g['items'] %}
    <li><a href="{{ r.out }}"><span class="name">{{ r.name }}</span>{% if r.area %}<span class="area">{{ r.area }}</span>{% endif %}</a></li>
{%- endfor %}
  </ul>
{%- endfor %}
  </main>
</body>
</html>
